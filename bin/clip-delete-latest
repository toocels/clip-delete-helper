#!/usr/bin/env bash
set -euo pipefail

out=$(gdbus call --session \
  --dest org.gnome.Shell \
  --object-path /dev/local/ClipDeleteHelper \
  --method dev.local.ClipDeleteHelper.DeleteLatest 2>&1) || {
  echo "clip-delete-latest: D-Bus call failed: $out" >&2
  echo "Is the 'Clip Delete Helper' extension enabled? Try: gnome-extensions enable clip-delete-helper@local" >&2
  exit 1
}

if [[ "$out" == "(true,)" ]]; then
  echo "Deleted latest clipboard history entry."
elif [[ "$out" == "(false,)" ]]; then
  echo "Nothing to delete (history is empty)." >&2
  exit 1
else
  echo "clip-delete-latest: unexpected response: $out" >&2
  exit 1
fi
